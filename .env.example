# Tapo Dashboard — Variables de configuracion
# Copiar a .env y ajustar valores segun tu entorno

# URL RTSP de la camara (cualquier camara RTSP compatible)
CAMERA_URL=rtsp://192.168.1.132:554/stream1

# "tapo" activa endpoints PTZ y control de camara via pytapo.
# Cambiar a "generic" para cualquier camara RTSP sin control de fabricante.
CAMERA_DRIVER=tapo

# Modelo YOLO — yolov8n.pt, yolo26n.pt, yolov8s.pt, etc.
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.45
# Clases COCO a detectar (lista separada por comas). 0 = persona.
YOLO_CLASSES=[0]
# Etiqueta mostrada en el overlay de bounding boxes
DETECTION_LABEL=person

DB_PATH=data/events.db
HOST=0.0.0.0
PORT=8000

# Credenciales Tapo (solo necesario si CAMERA_DRIVER=tapo)
TAPO_HOST=192.168.1.132
TAPO_USER=admin
TAPO_PASS=

# Linea virtual de conteo (fracciones 0.0-1.0 del frame)
LINE_START_X_FRAC=0.0
LINE_START_Y_FRAC=0.5
LINE_END_X_FRAC=1.0
LINE_END_Y_FRAC=0.5

# Resolucion de procesamiento (0 = nativa de la camara)
PROCESS_WIDTH=1280
PROCESS_HEIGHT=720

# Inferencia adaptativa (Fase 18): DetectionWorker/RecognitionWorker ajustan
# su ritmo segun la latencia real de inferencia, entre estos limites.
DETECTION_TARGET_FPS=8.0
DETECTION_MIN_FPS=3.0
DETECTION_MAX_FPS=12.0
RECOGNITION_TARGET_FPS=2.0

# Grabacion de clips
CLIPS_DIR=data/clips
RECORDING_FPS=15.0
RECORDING_TAIL_SECS=5.0
# Codec VideoWriter: "mp4v" (Windows fiable), "avc1" (H.264), "XVID"
RECORDING_CODEC=mp4v

# Pre/post-buffer de grabacion (Fase 20) — el clip incluye contexto antes y despues del evento
PRE_BUFFER_SECS=10.0
POST_BUFFER_SECS=10.0
PRE_BUFFER_MAX_MB=48
PRE_BUFFER_JPEG_QUALITY=85
LOCAL_RETENTION_DAYS=7
# Severidad minima para subir a Drive: info | warning | critical
UPLOAD_MIN_SEVERITY=warning
MAX_UPLOAD_ATTEMPTS=5
UPLOAD_POLL_SECS=30.0

# Observabilidad (Fase 21) — /metrics (Prometheus) y /api/v2/metrics (JSON)
METRICS_ENABLED=true
METRICS_SAMPLE_SECS=5.0

# Google Drive upload (dejar en blanco para deshabilitar)
GDRIVE_FOLDER_ID=
GDRIVE_CREDENTIALS_PATH=credentials.json
GDRIVE_TOKEN_PATH=data/token.json

# Autenticacion del dashboard (dejar vacio para acceso abierto en LAN)
DASHBOARD_USER=
DASHBOARD_PASS=

# HTTPS — dejar vacio para HTTP plano. Arrancar con: python -m backend.run
# El certificado autofirmado se genera automaticamente en certs/ al primer arranque.
SSL_CERTFILE=certs/cert.pem

# --- Alertas (DEPRECADO desde la Fase 19) ---
# La logica de "cuando alertar" vive ahora en config/rules.yaml (RuleEngine).
# Estas variables solo se leen una vez, por scripts/generate_initial_rules.py,
# para generar el rules.yaml inicial a partir de tu configuracion actual.
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_ON_INTRUSION=true
ALERT_ON_UNKNOWN=true
ALERT_ON_DETECTION=false
ALERT_COOLDOWN_SECS=60.0
ALERT_COUNT_THRESHOLD=0
SSL_KEYFILE=certs/key.pem
