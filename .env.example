# Copia este fichero como .env y ajústalo (DOCS-01). Todas las variables son
# opcionales: sin .env se usan los valores por defecto de backend/config.py.
# La referencia completa, con rangos y descripción, está en la vista Ajustes del
# dashboard y en backend/api/v2/config_schema.py.
# NUNCA pongas credenciales dentro de CAMERA_URL: usa RTSP_USER y RTSP_PASS.

# ── Cámara ────────────────────────────────────────────────────────────────────
CAMERA_URL=rtsp://192.168.1.132:554/stream2
RTSP_USER=
RTSP_PASS=
# "tapo" activa PTZ y ajustes de cámara vía pytapo; "generic" para otra cámara RTSP.
CAMERA_DRIVER=tapo
TAPO_HOST=192.168.1.132
TAPO_USER=admin
TAPO_PASS=
# Resolución de proceso; 0x0 = la nativa del stream.
PROCESS_WIDTH=1280
PROCESS_HEIGHT=720

# ── Acceso al dashboard ───────────────────────────────────────────────────────
# Con DASHBOARD_USER hay que definir también DASHBOARD_PASS o el backend no arranca.
DASHBOARD_USER=
DASHBOARD_PASS=
# HTTPS con certificado autofirmado (se genera en el primer arranque con backend.run).
SSL_CERTFILE=
SSL_KEYFILE=

# ── Detección ─────────────────────────────────────────────────────────────────
DETECTION_TARGET_FPS=8
# Hilos de PyTorch para YOLO en CPU (0 = valor de Ultralytics, núcleos - 1).
INFERENCE_THREADS=3
# Puerta de movimiento experimental: validar con la cámara antes de activarla.
MOTION_GATE_ENABLED=false

# ── Alertas ───────────────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ── Grabación y Google Drive ──────────────────────────────────────────────────
CLIPS_DIR=data/clips
UPLOAD_MIN_SEVERITY=warning
GDRIVE_FOLDER_ID=
GDRIVE_CREDENTIALS_PATH=credentials.json
GDRIVE_TOKEN_PATH=data/token.json

# ── Retención (días; 0 = no purgar) ───────────────────────────────────────────
# Se aplica al arrancar y cada día a RETENTION_HOUR.
EVENTS_RETENTION_DAYS=30
RECORDINGS_RETENTION_DAYS=30
LOCAL_RETENTION_DAYS=7
CAPTURES_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=30
PERSONS_RETENTION_DAYS=30
CLIPS_MAX_TOTAL_MB=20480
RETENTION_HOUR=3
