# Tapo Dashboard — Variables de configuracion
# Copiar a .env y ajustar valores segun tu entorno

# URL RTSP de la camara (cualquier camara RTSP compatible)
CAMERA_URL=rtsp://192.168.1.132:554/stream1

# "tapo" activa endpoints PTZ y control de camara via pytapo.
# Cambiar a "generic" para cualquier camara RTSP sin control de fabricante.
CAMERA_DRIVER=tapo

# Modelo YOLO — yolov8n.pt, yolo26n.pt, yolov8s.pt, etc.
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.45
# Clases COCO a detectar (lista separada por comas). 0 = persona.
YOLO_CLASSES=[0]
# Etiqueta mostrada en el overlay de bounding boxes
DETECTION_LABEL=person

DB_PATH=data/events.db
HOST=0.0.0.0
PORT=8000

# Credenciales Tapo (solo necesario si CAMERA_DRIVER=tapo)
TAPO_HOST=192.168.1.132
TAPO_USER=admin
TAPO_PASS=

# Linea virtual de conteo (fracciones 0.0-1.0 del frame)
LINE_START_X_FRAC=0.0
LINE_START_Y_FRAC=0.5
LINE_END_X_FRAC=1.0
LINE_END_Y_FRAC=0.5

# Resolucion de procesamiento (0 = nativa de la camara)
PROCESS_WIDTH=1280
PROCESS_HEIGHT=720

# Grabacion de clips
CLIPS_DIR=data/clips
RECORDING_FPS=15.0
RECORDING_TAIL_SECS=5.0
# Codec VideoWriter: "mp4v" (Windows fiable), "avc1" (H.264), "XVID"
RECORDING_CODEC=mp4v

# Google Drive upload (dejar en blanco para deshabilitar)
GDRIVE_FOLDER_ID=
GDRIVE_CREDENTIALS_PATH=credentials.json
GDRIVE_TOKEN_PATH=data/token.json
